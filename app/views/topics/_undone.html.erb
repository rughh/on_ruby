<div id="undone">
  <h3><%= t("home.new_topics") %></h3>

  <% if topics.present? %>
    <ul class="more-list undone clearfix">
      <% topics.each do |topic| %>
        <li class="topic">
          <%= link_to_topic topic %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>
      <%== t("home.no_new_topics", new_topic_link: link_to(t('topic.topic'), new_topic_path)) %>
    </p>
  <% end %>
</div>
