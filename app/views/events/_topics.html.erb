<% if event.topics.present? %>
  <h3 class="card-title"><%= t("main.topics") %></h3>

  <div class="row row-cols-1 row-cols-md-2 g-4">
    <% event.topics.each do |topic| %>
      <div class="col">
        <div class="card h-100">
          <div class="card-header">
            <div class="pull-left">
              <%= link_to(topic.user) do %>
                <%= user_image(topic.user, variant: 'topic-header') %>
              <% end %>
            </div>

            <%= link_to_user(topic.user) %>
          </div>

          <div class="card-body">
            <h5 class="card-title"><%= link_to_topic(topic) %></h5>

            <div class="card-text collapser">
              <%== markdown(topic.description) %>
            </div>
          </div>

          <% if topic.materials.present? %>
            <ul class="list-group list-group-flush">
              <% topic.materials.each do |material| %>
                <li class="list-group-item">
                  <%= link_to_material(material) %>
                </li>
              <% end %>
            </ul>
          <% end %>

          <div class="card-footer">
            <small class="text-muted">
              <%= link_to t('topic.likes', count: topic.likes.count), topic %>
            </small>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
