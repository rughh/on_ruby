<% if materials.present? %>
  <h3 class="card-title" id="materials"><%= t("main.materials") %></h3>
  <ul>
    <% materials.each do |material| %>
      <li>
        <%= link_to_material(material) %>
        <%== " (#{link_to_user(material.user)})" if material.user %>
        <%= material_preview(material) %>
      </li>
    <% end %>
  </ul>
<% end %>
